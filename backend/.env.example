APP_ENV=
FRONTEND_ORIGIN=
# Set to true only when you intentionally want temporary anonymous local fallback.
ALLOW_DEV_DEMO_USER=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_MINUTES=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
LLM_REQUEST_TIMEOUT_SECONDS=
LLM_MAX_COMPLETION_TOKENS=
REMINDER_SCAN_INTERVAL_SECONDS=
REMINDER_NOTIFICATION_ENABLED=
# Optional: set this to enable external reminder notifications through PushDeer.
# PUSHDEER_PUSHKEY=PDU...
# PUSHDEER_ENDPOINT=https://api2.pushdeer.com/message/push
# Optional: set this to enable Enterprise WeChat group bot notifications.
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# Optional: set this to enable ServerChan Turbo WeChat notifications.
# SERVERCHAN_SENDKEY=SCT...
# SERVERCHAN_ENDPOINT_BASE=https://sctapi.ftqq.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# Local default is SQLite if DATABASE_URL is not overridden.
# Example PostgreSQL target:
# The backend will try to run `CREATE EXTENSION IF NOT EXISTS vector` on startup.
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
