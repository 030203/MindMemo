APP_ENV=dev
FRONTEND_ORIGIN=http://127.0.0.1:6100
# Set to true only when you intentionally want temporary anonymous local fallback.
ALLOW_DEV_DEMO_USER=false
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_COMPLETION_TOKENS=700
REMINDER_SCAN_INTERVAL_SECONDS=60
REMINDER_NOTIFICATION_ENABLED=true
# Optional: set this to enable external reminder notifications through PushDeer.
# PUSHDEER_PUSHKEY=PDU...
# PUSHDEER_ENDPOINT=https://api2.pushdeer.com/message/push
# Optional: set this to enable Enterprise WeChat group bot notifications.
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# Optional: set this to enable ServerChan Turbo WeChat notifications.
# SERVERCHAN_SENDKEY=SCT...
# SERVERCHAN_ENDPOINT_BASE=https://sctapi.ftqq.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# Local default is SQLite if DATABASE_URL is not overridden.
# Example PostgreSQL target:
# The backend will try to run `CREATE EXTENSION IF NOT EXISTS vector` on startup.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/mysecondbrain
DEEPSEEK_API_KEY=sk-c778af93f32b4f779d7a41941c8aeda8
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-c778af93f32b4f779d7a41941c8aeda8
